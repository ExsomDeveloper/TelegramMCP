# Token from @BotFather
BOT_TOKEN=
# Your Telegram chat id. Leave empty, start the daemon and send /start to the bot — it will reply with the id.
ALLOWED_CHAT_ID=
# Local port for MCP (/mcp) and hook (/hook/*) endpoints
PORT=8787
# Default wait for ask/approve, seconds
ASK_TIMEOUT_SEC=240
APPROVE_TIMEOUT_SEC=300

# Optional: custom Bot API server URL (self-hosted telegram-bot-api)
# TELEGRAM_API_ROOT=
